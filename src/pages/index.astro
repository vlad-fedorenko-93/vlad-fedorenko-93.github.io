---
import { getCollection } from "astro:content";
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.svelte";
import About from "../components/About.svelte";
import Contact from "../components/Contact.svelte";
import Button from "../components/Button.svelte";
import CaseStudyItem from "../components/CaseStudyItem.svelte";
import { Image } from "astro:assets";

const posts = await getCollection("posts");
const postPreview = posts.slice(-2);

const portfolio = await getCollection("portfolio");
const portfolioPreview = portfolio.slice(-2);

const portfolioThumbnails = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/thumbnails/portfolio/**/thumbnail.{avif,jpg,jpeg,png,webp}",
  { eager: true },
);
const postThumbnails = import.meta.glob<{ default: ImageMetadata }>(
  "../assets/thumbnails/posts/**/thumbnail.{avif,jpg,jpeg,png,webp}",
  { eager: true },
);
---

<Layout title="Vladislav Fedorenko">
  <Hero client:load />
  <About />

  <!-- Portfolio -->
  <section class="bg">
    <div class="content m-auto w-3/4 py-40 grid grid-cols-5 gap-4">
      <div class="title col-span-2">
        <h2 class="text mb-2 w-4/5 text-5xl font-bold">
          What I've been working on
        </h2>
        <p class="text-muted mb-8 w-2/3 text-xl">
          My portfolio showcases my latest projects and case studies
        </p>
        <Button label="See portfolio" slug="/portfolio" />
      </div>
      <div class="cards col-span-3 grid grid-cols-2 gap-4">
        {
          portfolioPreview.map((caseStudy) => {
            const thumbnailKey = Object.keys(portfolioThumbnails).find((path) =>
              path.includes(`/portfolio/${caseStudy.id}/thumbnail.`),
            );
            return (
              <CaseStudyItem
                title={caseStudy.data.title}
                slug={`/portfolio/${caseStudy.id}`}
                description={caseStudy.data.description}
                date={caseStudy.data.year}
              >
                {thumbnailKey && (
                  <Image
                    src={portfolioThumbnails[thumbnailKey].default}
                    alt={caseStudy.data.title}
                  />
                )}
              </CaseStudyItem>
            );
          })
        }
      </div>
    </div>
  </section>

  <!-- Posts -->
  <section class="bg">
    <div class="content m-auto w-3/4 py-40 grid grid-cols-5 gap-4">
      <div class="title col-span-2">
        <h2 class="text mb-2 w-4/5 text-5xl font-bold">Sharing insights</h2>
        <p class="text-muted mb-8 w-2/3 text-xl">
          My blog features articles on web development, design, and more
        </p>
        <Button label="See blog" slug="/posts" />
      </div>
      <div class="cards col-span-3 grid grid-cols-2 gap-4">
        {
          postPreview.map((post) => {
            const thumbnailKey = Object.keys(postThumbnails).find((path) =>
              path.includes(`/posts/${post.id}/thumbnail.`),
            );
            return (
              <CaseStudyItem
                title={post.data.title}
                slug={`/posts/${post.id}`}
                description={post.data.description}
                date={post.data.date}
              >
                {thumbnailKey && (
                  <Image
                    src={postThumbnails[thumbnailKey].default}
                    alt={post.data.title}
                  />
                )}
              </CaseStudyItem>
            );
          })
        }
      </div>
    </div>
  </section>

  <Contact />
</Layout>

<style>
  .bg {
    background-color: var(--color-base-100);
  }

  .text {
    color: var(--color-base-content);
  }

  .text-muted {
    color: var(--color-base-content-muted);
  }

  @media (max-width: 900px) {
    .content {
      grid-template-rows: fit-content fit-content;
      grid-template-columns: 1fr;
      padding: 4rem 0;
    }

    .content div {
      grid-column: auto;
      grid-row: auto;
    }

    .content .title {
      margin-bottom: 4rem;
    }

    .content .title h2 {
      font-size: 2.5rem;
      width: 100%;
    }

    .content .title p {
      width: 100%;
    }

    .content .cards {
      grid-template-columns: 1fr;
      grid-template-rows: auto;
    }

    .content div h1 {
      font-size: 2.5rem;
    }
  }
</style>
